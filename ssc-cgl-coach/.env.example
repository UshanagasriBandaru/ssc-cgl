# Copy this file to `.env.local` and fill in values. `.env.local` is not committed.

# Recommended: Gemini free tier — create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional fallbacks if GEMINI_API_KEY is unset
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional — cloud sign-in, notebook, uploads (https://supabase.com free tier)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
